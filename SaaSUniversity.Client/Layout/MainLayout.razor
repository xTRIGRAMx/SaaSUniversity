@using Microsoft.AspNetCore.Components.Authorization
@using SaaSUniversity.Client.Service
@using SaaSUniversity.Shared
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inherits LayoutComponentBase
@inject UserState UserState
@inject HttpClient Http
@inject CookieAuthenticationStateProvider CookieAuthStateProvider
@inject IAuthService AuthService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="ml-auto">
                        Hello, @context.User.Identity?.Name!
                        <button class="btn btn-link" @onclick="Logout">Logout</button>
                    </span>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="ml-auto">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    private async Task Logout()
    {
        if (await AuthService.LogoutAsync())
        {
            UserState.Clear();
            CookieAuthStateProvider.NotifyUserLogout();
        }
    }
}