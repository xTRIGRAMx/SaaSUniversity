@page "/courses"
@using SaaSUniversity.Shared
@inject SaaSUniversity.Client.Service.CoursesService.ICourseService CourseService

<div class="container mt-4">
    <h3 class="mb-4 text-dark fw-bold">Available Courses</h3>

    @if (pagedResult == null)
    {
        <div class="d-flex align-items-center mt-5">
            <strong class="text-primary">Loading course catalog...</strong>
            <div class="spinner-border text-primary ms-auto" role="status" aria-hidden="true"></div>
        </div>
    }

    else
    {
        <div class="card shadow-sm border-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="py-3 ps-3">Title</th>
                        <th scope="col" class="py-3">Students Enrolled</th>
                        <th scope="col" class="py-3">Scheduled Classes</th>
                        <th scope="col" class="py-3 text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in pagedResult.Items)
                    {
                        <tr>
                            <td class="fw-semibold text-dark ps-3">@course.Title</td>
                            <td>
                                <span class="badge bg-secondary rounded-pill">@course.StudentCount Students</span>
                            </td>
                            <td>
                                @if (course.Classes != null && course.Classes.Any())
                                {
                                    <ul class="list-unstyled mb-0 font-13 text-secondary">
                                        @foreach (var cls in course.Classes)
                                        {
                                            <li><i class="icon-calendar me-1 text-primary"></i> @cls.Name (@cls.Schedule)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <small class="text-muted">No classes assigned</small>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <AuthorizeView>
                                    <Authorized>
                                        <button class="btn btn-sm btn-primary px-3 rounded" @onclick="() => Enroll(course.Id)">
                                            Enroll
                                        </button>
                                    </Authorized>
                                    <NotAuthorized>
                                        <button class="btn btn-sm btn-outline-secondary px-3 rounded" disabled title="Please log in to enroll">
                                            Enroll
                                        </button>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 bg-light p-3 rounded shadow-sm">
            <div class="text-muted font-14">
                Showing Page <strong>@pagedResult.PageNumber</strong> of <strong>@pagedResult.TotalPages</strong> (Total: @pagedResult.TotalCount courses)
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(pagedResult.HasPreviousPage ? "" : "disabled")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                    </li>

                    @for (int i = 1; i <= pagedResult.TotalPages; i++)
                    {
                        var pageIdx = i;
                        <li class="page-item @(pageIdx == currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageIdx)">@pageIdx</button>
                        </li>
                    }

                    <li class="page-item @(pagedResult.HasNextPage ? "" : "disabled")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info mt-3 py-2 text-center" role="alert">
            @message
        </div>
    }
</div>

@code {
    private PagedResult<CourseDto>? pagedResult;
    private int currentPage = 1;
    private int pageSize = 5; // Limits items to 5 per view slice
    private string message = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadCourses();

    private async Task LoadCourses()
    {
        pagedResult = await CourseService.GetAvailableCoursesAsync(currentPage, pageSize);
    }

    private async Task ChangePage(int newPage)
    {
        currentPage = newPage;
        await LoadCourses();
    }

    private async Task Enroll(int courseId)
    {
        if (await CourseService.EnrollAsync(courseId))
        {
            message = "Enrollment successful!";
            await LoadCourses();
        }
        else
        {
            message = "Enrollment failed. You might already be enrolled.";
        }
    }
}