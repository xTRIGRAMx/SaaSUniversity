@page "/courses"
@using SaaSUniversity.Shared
@inject ICourseService CourseService

<h3>Available Courses</h3>

@if (courses == null)
{
    <p>Loading courses...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Students Enrolled</th>
                <th>Classes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in courses)
            {
                <tr>
                    <td>@course.Title</td>
                    <td>@course.StudentCount</td>
                    <td>
                        <ul>
                            @foreach (var cls in course.Classes)
                            {
                                <li>@cls.Name (@cls.Schedule)</li>
                            }
                        </ul>
                    </td>
                    <td>
                        @* 🔑 RESTORED: Control button state using the new service bindings *@
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-primary" @onclick="() => Enroll(course.Id)">
                                    Enroll
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                <button class="btn btn-primary" disabled title="Please log in to enroll">
                                    Enroll
                                </button>
                            </NotAuthorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="text-info">@message</p>

@code {
    private List<CourseDto>? courses;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadCourses();

    private async Task LoadCourses() => courses = await CourseService.GetAvailableCoursesAsync();

    private async Task Enroll(int courseId)
    {
        if (await CourseService.EnrollAsync(courseId))
        {
            message = "Enrollment successful!";
            await LoadCourses(); // Triggers service refresh seamlessly
        }
        else
        {
            message = "Enrollment failed. You might already be enrolled.";
        }
    }
}
