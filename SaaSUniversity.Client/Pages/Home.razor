@page "/"

<div class="height-400" style="background:url(/img/campus.jpg); background-size: cover; background-repeat: no-repeat;background-position: center center;">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-4 pt-100">
                <div class="p-30 bg-dark text-white" style="opacity:0.85">
                    <div class="font-19 pl-15 pb-5">SaaS solution</div>
                    <ul>
                        <li>Multi-tenant</li>
                        <li>Multi-timezone</li>
                        <li>Multi-language</li>
                        <li>Multi-locale</li>
                        <li>Multi-currency</li>
                    </ul>
                </div>

            </div>
        </div>
    </div>


</div>

<div class="landing-bar">
    <div class="container">
        <div class="landing-bar-text">SaaS University, &nbsp;Cape Town, South Africa.</div>
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-4">
        <h3 class="mb-4">Statistics</h3>
        <div >
            <table class="table table-hover table-sm ">
                <tbody>
                    <tr>
                        <td class="width-70">
                            <a href="tenants"><i class="icon-globe"></i></a>
                        </td>
                        <td class="pt-9">
                            <a class="table-list-link" href="tenants">Tenants</a>
                        </td>
                        <td class="pt-9">@TenantCount</td>
                    </tr>

                    <tr>
                        <td class="width-70">
                            <a href="users"><i class="icon-user"></i></a>
                        </td>
                        <td class="pt-9">
                            <a class="table-list-link" href="users">Users</a>
                        </td>
                        <td class="pt-9">@UserCount</td>
                    </tr>

                    <tr>
                        <td class="width-70">
                            <a href="students"><i class="icon-people"></i></a>
                        </td>
                        <td class="pt-9">
                            <a class="table-list-link" href="students">Students</a>
                        </td>
                        <td class="pt-9">@StudentCount</td>
                    </tr>

                    <tr>
                        <td class="width-70">
                            <a href="enrollments"><i class="icon-doc"></i></a>
                        </td>
                        <td class="pt-9">
                            <a class="table-list-link" href="enrollments">Enrollments</a>
                        </td>
                        <td class="pt-9">@EnrollmentCount</td>
                    </tr>

                    <tr>
                        <td class="width-70">
                            <a href="classes"><i class="icon-calendar"></i></a>
                        </td>
                        <td class="pt-9">
                            <a class="table-list-link" href="classes">Classes</a>
                        </td>
                        <td class="pt-9">@ClassCount</td>
                    </tr>

                    <tr>
                        <td class="width-70">
                            <a href="courses"><i class="icon-book-open"></i></a>
                        </td>
                        <td class="pt-9">
                            <a class="table-list-link" href="courses">Courses</a>
                        </td>
                        <td class="pt-9">@CourseCount</td>
                    </tr>

                    <tr>
                        <td class="width-70">
                            <a href="instructors"><i class="icon-briefcase"></i></a>
                        </td>
                        <td class="pt-9">
                            <a class="table-list-link" href="instructors">Instructors</a>
                        </td>
                        <td class="pt-9">@InstructorCount</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-8 ps-md-5">
        <h3 class="mb-4">Welcome</h3>
        <p class="text-muted" style="line-height: 1.7; font-size: 15px;">
            SaaS University is a multi-tenant SaaS solution. It's designed for universities and other educational organizations to help them manage and maintain students, courses, instructors, enrollments, and other information.
        </p>
        <p class="text-muted" style="line-height: 1.7; font-size: 15px;">
            This modern SaaS application is <em>multi-tenant, multi-language, multi-locale, multi-timezone,</em> and <em>multi-currency</em>. This solution was created with modern design patterns, best practices, and advanced SaaS techniques.
        </p>
        <p class="text-muted" style="line-height: 1.7; font-size: 15px; margin-top: 2rem;">
            The application is fully DX (Design Excellence™) and CX (Code Excellence™) compliant, with a simple-to-use, attractive UI.
        </p>
    </div>
</div>

@code {
    private int TenantCount { get; set; } = 5;
    private int UserCount { get; set; } = 6;
    private int StudentCount { get; set; } = 78;
    private int EnrollmentCount { get; set; } = 200;
    private int ClassCount { get; set; } = 64;
    private int CourseCount { get; set; } = 53;
    private int InstructorCount { get; set; } = 46;
}