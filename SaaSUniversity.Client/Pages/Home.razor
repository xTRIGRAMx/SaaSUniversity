@page "/"
@using SaaSUniversity.Shared
@inject SaaSUniversity.Client.Service.CoursesService.ICourseService CourseService

<div class="height-400" style="background:url(/img/campus.jpg); background-size: cover; background-repeat: no-repeat;background-position: center center;">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-4 pt-100">
                <div class="p-30 bg-dark text-white" style="opacity:0.85">
                    <div class="font-19 pl-15 pb-5">SaaS solution</div>
                    <ul>
                        <li>Strict Separation of Concerns</li>
                        <li>Decoupled Frontend Services:</li>
                        <li>Robust Boundary Protection</li>
                        <li>Unified State Synchronization</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="landing-bar">
    <div class="container">
        <div class="landing-bar-text">SaaS University, &nbsp;Cape Town, South Africa.</div>
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-4">
        <h3 class="mb-4">Statistics</h3>
        <div>
            <table class="table table-hover table-sm">
                <tbody>
                    <tr>
                        <td class="width-70 text-secondary"><i class="icon-globe"></i></td>
                        <td class="pt-9 text-dark fw-semibold">Tenants</td>
                        <td class="pt-9 fw-bold text-primary">@stats.TenantCount</td>
                    </tr>
                    <tr>
                        <td class="width-70 text-secondary"><i class="icon-user"></i></td>
                        <td class="pt-9 text-dark fw-semibold">Users</td>
                        <td class="pt-9 fw-bold text-primary">@stats.UserCount</td>
                    </tr>
                    <tr>
                        <td class="width-70 text-secondary"><i class="icon-people"></i></td>
                        <td class="pt-9 text-dark fw-semibold">Students</td>
                        <td class="pt-9 fw-bold text-primary">@stats.StudentCount</td>
                    </tr>
                    <tr>
                        <td class="width-70 text-secondary"><i class="icon-doc"></i></td>
                        <td class="pt-9 text-dark fw-semibold">Enrollments</td>
                        <td class="pt-9 fw-bold text-primary">@stats.EnrollmentCount</td>
                    </tr>
                    <tr>
                        <td class="width-70 text-secondary"><i class="icon-calendar"></i></td>
                        <td class="pt-9 text-dark fw-semibold">Classes</td>
                        <td class="pt-9 fw-bold text-primary">@stats.ClassCount</td>
                    </tr>
                    <tr>
                        <td class="width-70 text-secondary"><i class="icon-book-open"></i></td>
                        <td class="pt-9 text-dark fw-semibold">Courses</td>
                        <td class="pt-9 fw-bold text-primary">@stats.CourseCount</td>
                    </tr>
                    <tr>
                        <td class="width-70 text-secondary"><i class="icon-briefcase"></i></td>
                        <td class="pt-9 text-dark fw-semibold">Instructors</td>
                        <td class="pt-9 fw-bold text-primary">@stats.InstructorCount</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-8 ps-md-5">
        <h3 class="mb-4">Welcome</h3>
        <p class="text-muted" style="line-height: 1.7; font-size: 15px;">
            SaaS University is a SaaS solution. It's designed for universities and other educational organizations to help them manage and maintain students, enrollments, classes and other information.
        </p>
        <p class="text-muted" style="line-height: 1.7; font-size: 15px;">
            The app application is built as a decoupled, multi-tier Single Page Application (SPA)
            leveraging Blazor WebAssembly (WASM) on the front end and an ASP.NET Core Minimal/Web API backend.
        </p>
        <p class="text-muted" style="line-height: 1.7; font-size: 15px;">
            The architectural layout emphasizes clean separation of concerns, high-performance data processing, and enterprise scalability patterns.
        </p>
        <p class="text-muted" style="line-height: 1.7; font-size: 15px; margin-top: 2rem;">
            The application is DX and CX compliant, with a simple-to-use, attractive UI.
        </p>
    </div>
</div>

@code {
    private DashboardStatsDto stats = new();

    protected override async Task OnInitializedAsync()
    {
        var liveData = await CourseService.GetDashboardStatsAsync();
        if (liveData != null)
        {
            stats = liveData;
        }
    }
}