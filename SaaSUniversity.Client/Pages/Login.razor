@page "/login"
@using SaaSUniversity.Shared
@inject HttpClient Http
@inject UserState UserState
@inject IAuthService AuthService
@inject NavigationManager NavigationManager


@inject CookieAuthenticationStateProvider CookieAuthStateProvider

@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<h3>Login</h3>

<input class="form-control" @bind="email" placeholder="Email" />
<input class="form-control" @bind="password" type="password" placeholder="Password" />
<button class="btn btn-success" @onclick="HandleLogin">Login</button>

<p class="text-info mt-2">@message</p>
@code {

    private string email = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;
    private string token = string.Empty;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            message = "Please complete all fields.";
            return;
        }

        var dto = new StudentDto { Email = email, Password = password };
        var result = await AuthService.LoginAsync(dto);

        if (result != null)
        {
            UserState.SetEmail(dto.Email);

            // 🔑 This will now compile perfectly because it points to the correct Shared DTO model!
            CookieAuthStateProvider.NotifyUserAuthentication(dto.Email, result.StudentId);
            message = "Login successful!";

            NavigationManager.NavigateTo("courses");
        }
        else
        {
            message = "Login failed. Invalid credentials.";
        }
    }
}
