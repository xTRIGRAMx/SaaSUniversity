@page "/login"
@using SaaSUniversity.Shared
@inject HttpClient Http
@inject UserState UserState
@inject IAuthService AuthService

@inject CookieAuthenticationStateProvider CookieAuthStateProvider

@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<h3>Login</h3>

<input @bind="email" placeholder="Email" />
<input @bind="password" type="password" placeholder="Password" />
<button @onclick="HandleLogin">Login</button>

<p>@message</p>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;
    private string token = string.Empty;

@code {
    private async Task HandleLogin()
    {
        var dto = new StudentDto { Email = email, Password = password };
        var result = await AuthService.LoginAsync(dto);

        if (result != null)
        {
            UserState.SetEmail(dto.Email);
            CookieAuthStateProvider.NotifyUserAuthentication(dto.Email, result.StudentId);
            message = "Login successful!";
        }
        else
        {
            message = "Login failed.";
        }
    }
}


    public class LoginResult
    {
        public string Token { get; set; } = string.Empty;
        public int StudentId { get; set; }
    }
}
