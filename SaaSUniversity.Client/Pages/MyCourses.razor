@page "/mycourses"
@using SaaSUniversity.Shared
@inject ICourseService CourseService

<h3>My Enrolled Courses</h3>

@if (student == null)
{
    <p>Loading your courses...</p>
}
else if (student.EnrolledCourses.Count == 0)
{
    <p>You are not enrolled in any courses yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Course Title</th>
                <th>Classes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in student.EnrolledCourses)
            {
                <tr>
                    <td>@course.Title</td>
                    <td>
                        <ul>
                            @foreach (var cls in course.Classes)
                            {
                                <li>@cls.Name (@cls.Schedule)</li>
                            }
                        </ul>
                    </td>
                    <td>
                        <button class="btn btn-danger" @onclick="() => Deregister(course.Id)">Deregister</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="text-info">@message</p>

@code {
    private StudentDto? student;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadMyCourses();

    private async Task LoadMyCourses() => student = await CourseService.GetMyEnrolledCoursesAsync();

    private async Task Deregister(int courseId)
    {
        if (await CourseService.DeregisterAsync(courseId))
        {
            message = "Deregistered successfully!";
            await LoadMyCourses();
        }
        else
        {
            message = "Failed to deregister.";
        }
    }
}
