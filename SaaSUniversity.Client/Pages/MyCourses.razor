@page "/mycourses"
@using SaaSUniversity.Shared
@inject SaaSUniversity.Client.Service.CoursesService.ICourseService CourseService

<div class="container mt-4">
    <h3 class="mb-4 text-dark fw-bold">My Enrolled Courses</h3>

    @if (student == null)
    {
        <div class="d-flex align-items-center mt-5">
            <strong class="text-danger">Loading your student profile...</strong>
            <div class="spinner-border text-danger ms-auto" role="status" aria-hidden="true"></div>
        </div>
    }
    else if (student.EnrolledCourses == null || !student.EnrolledCourses.Any())
    {
        <div class="alert alert-info text-center mt-4 shadow-sm border-0">
            <i class="icon-info me-2"></i> You are not currently enrolled in any university courses.
            <br />
            <a href="courses" class="btn btn-sm btn-outline-primary mt-2">Browse the Course Catalog</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="py-3 ps-3">Course Title</th>
                        <th scope="col" class="py-3">Scheduled Classes</th>
                        <th scope="col" class="py-3 text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in student.EnrolledCourses)
                    {
                        <tr>
                            <td class="fw-semibold text-dark ps-3">@course.Title</td>
                            <td>
                                @if (course.Classes != null && course.Classes.Any())
                                {
                                    <ul class="list-unstyled mb-0 font-13 text-secondary">
                                        @foreach (var cls in course.Classes)
                                        {
                                            <li><i class="icon-calendar me-1 text-danger"></i> @cls.Name (@cls.Schedule)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <small class="text-muted">No classes assigned to this course</small>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-danger px-3 rounded shadow-sm" @onclick="() => Deregister(course.Id)">
                                    Deregister
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-end text-muted font-13 pe-2">
            Total active enrollments: <strong>@student.EnrolledCourses.Count</strong>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info mt-3 py-2 text-center shadow-sm" role="alert">
            @message
        </div>
    }
</div>

@code {
    private StudentDto? student;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadMyCourses();

    private async Task LoadMyCourses()
    {
        student = await CourseService.GetMyEnrolledCoursesAsync();
    }

    private async Task Deregister(int courseId)
    {
        if (await CourseService.DeregisterAsync(courseId))
        {
            message = "Deregistered successfully!";
            await LoadMyCourses(); // Refresh local profile grid view seamlessly
        }
        else
        {
            message = "Failed to complete deregistration routing process.";
        }
    }
}