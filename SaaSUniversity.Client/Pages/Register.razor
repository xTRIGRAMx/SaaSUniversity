@page "/register"
@inject IAuthService AuthService
@inject CookieAuthenticationStateProvider CookieAuthStateProvider
@inject NavigationManager NavigationManager

<h3>Register</h3>

<div class="form-group mb-3">
    <input @bind="email" class="form-control" placeholder="Email" />
</div>
<div class="form-group mb-3">
    <input @bind="password" type="password" class="form-control" placeholder="Password" />
</div>

<button class="btn btn-success" @onclick="HandleRegister">Register</button>

<p class="text-info mt-2">@message</p>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;

    private async Task HandleRegister()
    {
        // 1. Map to your registration data structure
        var dto = new Shared.StudentDto { Email = email, Password = password };

        // 2. Execute via the clean service interface contract layer
        var result = await AuthService.RegisterAsync(dto);

        if (result != null)
        {
            message = "Registration and login successful!";

            // 3. Notify the local state subsystem to instantly unlock UI elements
            CookieAuthStateProvider.NotifyUserAuthentication(dto.Email, result.StudentId);

            // 4. Smoothly route the student directly into the catalog dashboard
            NavigationManager.NavigateTo("courses");
        }
        else
        {
            message = "Registration failed. Email might already be in use.";
        }
    }
}
